"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":"ltr","format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"background-color: #ffdda5;line-height: 1.15;","text":"1. xxxxxxxxxxxxxxxxxx","type":"text","version":1}],"direction":"ltr","format":"justify","indent":1,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":"ltr","format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"background-color: #ffdda5;line-height: 1.15;","text":"2. xxxxxxxxxxxxxxxxxx","type":"text","version":1}],"direction":"ltr","format":"justify","indent":1,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":"ltr","format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":2,"format":0,"mode":"normal","style":"line-height: 1.15;","text":"\t","type":"tab","version":1},{"detail":0,"format":0,"mode":"normal","style":"line-height: 1.15;","text":"This office is in the process of locating the owner(s) of the above items. In the meantime, if the items belong to you and/or your family, I would appreciate if you would take action to remove them within <<noticeDurationInDays>> days of the date of this letter; otherwise, Government may remove the items and also take appropriate action against the owner(s).","type":"text","version":1}],"direction":"ltr","format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":"ltr","format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":2,"format":0,"mode":"normal","style":"line-height: 1.15;","text":"\t","type":"tab","version":1},{"detail":0,"format":0,"mode":"normal","style":"line-height: 1.15;","text":"If the said items do not belong to you or you have recently removed them from the unleased land, please ignore this letter.  Should you have any questions regarding the matter, please feel free to contact me at Telephone No. <<senderPhone>>.","type":"text","version":1}],"direction":"ltr","format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Yours faithfully,","type":"text","version":1},{"detail":0,"format":8,"mode":"normal","style":"background-color: #ffffff;color: #ffffff;","text":"__     ___","type":"text","version":1}],"direction":"ltr","format":"right","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":null,"format":"right","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direction":null,"format":"right","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"line-height: 1.15;","text":"(<<senderNameEn>>)","type":"text","version":1},{"detail":0,"format":8,"mode":"normal","style":"line-height: 1.15;color: #ffffff;","text":"         ","type":"text","version":1}],"direction":"ltr","format":"right","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":0,"mode":"normal","style":"line-height: 1.15;","text":"for District Lands Officer/ ","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"font-size: 15px;line-height: 1.15;","text":"<<dloEn>>","type":"text","version":1}],"direction":"ltr","format":"right","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[],"direc